# Copy to .env.local (never commit .env.local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=local
# Sign-up / log-in screens: "preview" (click-through fake, nothing saved) until the
# API's sign-in feature is live, then "api". Production always uses the API.
NEXT_PUBLIC_AUTH_MODE=preview
